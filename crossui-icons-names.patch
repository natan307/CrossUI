index 0000000..d7f1f40
--- /dev/null
+++ b/crossui-core/src/main/java/io/github/natan307/crossui/core/renderer/IconResolver.java
@@ -0,0 +1,70 @@
+/*
+ * CrossUI - Cross-platform UI bridge between Java Chest GUIs, Native Dialogs, and Bedrock Forms.
